<Window x:Class="WallZ.UI.WallpaperPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WALL Z — Preview"
        WindowStyle="None"
        Background="Black"
        WindowState="Maximized"
        Topmost="True"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">

    <Grid x:Name="RootGrid" Opacity="0">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:0.35"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <!-- Video player -->
        <MediaElement x:Name="PreviewPlayer"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Stop"
                      Stretch="Uniform"
                      Volume="0"
                      MediaEnded="PreviewPlayer_MediaEnded"/>

        <!-- Bottom overlay scrim + controls -->
        <Border VerticalAlignment="Bottom">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0008090B" Offset="0"/>
                    <GradientStop Color="#F008090B" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="36,26,36,32">
                <!-- Wallpaper info (left) -->
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="PREVIEW" FontSize="9.5" FontWeight="Bold"
                               Foreground="#C9993A" Margin="0,0,0,5"
                               FontFamily="Segoe UI Variable Display"/>
                    <TextBlock x:Name="WallpaperTitleLabel" Text="Wallpaper"
                               FontSize="20" FontWeight="Bold" Foreground="#F8F9FA"
                               FontFamily="Palatino Linotype"/>
                    <TextBlock Text="Press ESC to close without applying"
                               FontSize="11.5" Foreground="#5F6573" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Action buttons (right) -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Apply button with gold glow -->
                    <Button x:Name="ApplyBtn" Margin="0,0,12,0"
                            Padding="22,11" Cursor="Hand"
                            Click="ApplyBtn_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Border x:Name="Glow" CornerRadius="12" Margin="0,3,0,-3" Opacity="0.55">
                                        <Border.Background><SolidColorBrush Color="#7A5B1A"/></Border.Background>
                                        <Border.Effect><BlurEffect Radius="14"/></Border.Effect>
                                    </Border>
                                    <Border x:Name="Btn" CornerRadius="10" Background="#C9993A" Padding="{TemplateBinding Padding}">
                                        <Grid>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Border CornerRadius="10,10,0,0" Height="11" VerticalAlignment="Top" IsHitTestVisible="False">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#24FFFFFF" Offset="0"/>
                                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Glow" Property="Opacity" Value="0.9"/>
                                        <Setter TargetName="Btn" Property="Background" Value="#E8B84B"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Btn" Property="Background" Value="#9A6818"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="✓  Apply to Desktop"
                                   FontFamily="Segoe UI Variable Display"
                                   FontSize="12.5" FontWeight="SemiBold" Foreground="#0C0D0F"/>
                    </Button>

                    <!-- Close button -->
                    <Button x:Name="CloseBtn" Padding="18,11" Cursor="Hand"
                            Click="CloseBtn_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="B" CornerRadius="10"
                                        Background="#24FFFFFF"
                                        BorderBrush="#2AFFFFFF" BorderThickness="1"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="B" Property="Background" Value="#40FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="✕  Close Preview"
                                   FontFamily="Segoe UI Variable Display"
                                   FontSize="12.5" FontWeight="SemiBold" Foreground="#F8F9FA"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
