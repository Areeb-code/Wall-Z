project.fragment.lock.json

# Keep NuGet.Config if it contains no secrets.
# Never commit credentials or private package tokens.

# ==========================================
# WPF Generated Files
# ==========================================
# Build-generated WPF files are normally inside bin/ or obj/
# Keep handwritten XAML and code-behind files tracked.
# Do not ignore *.g.cs globally.

